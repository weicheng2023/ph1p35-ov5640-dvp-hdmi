# ============================================================================
# top_hdmi_colorbar.adc
# Pin constraints for the independent HDMI color-bar source.
#
# Top   : top_hdmi_colorbar
# Device: PH1P35MDG324 (PH1P35_FT V1 / HX1P35B_FT_40P)
#
# Source of truth: docs/hardware/wiring.md (HDMI section) and
# verification/board/evidence/20261107_hdmi_pin_review/README.md
#
# HDMI1 is a source/output:
#   - +5V on connector pin 18 is supplied by the board through D5.
#   - HPD is driven by the sink and read by the FPGA.
#   - DDC is level-shifted from 3.3V (FPGA) to 5V (connector).
#   - TMDS pairs go from Bank32 through ESD arrays to the connector.
#   - 8 x 49.9 ohm pull-ups to +3.3V_HDMI are on the board.
#
# Only the P side is constrained. TD infers the N side from the TMDS33
# differential pair: G16/H16, F17/E18, H14/H13, C17/D18.
# ============================================================================

# 50 MHz oscillator (C4, BANK42)
set_pin_assignment { clk_50m } { LOCATION = C4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# LEDs (BANK42, active high; D10/E10/C6/D6 -> physical LED1..4)
set_pin_assignment { led[0] } { LOCATION = D10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[1] } { LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[2] } { LOCATION = C6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[3] } { LOCATION = D6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# TMDS outputs (BANK32, VCCIO_32 = VCC_3V3)
# Pin/IO standard checked against: P01_FPGA sheet, TD ph1p_macro.v (TMDS33),
# and the third-party PH1P35 reference project (same P-side balls, TMDS33).
set_pin_assignment { tmds_d0_p }  { LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { tmds_d1_p }  { LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { tmds_d2_p }  { LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { tmds_clk_p } { LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }

# HDMI1_SCL / HDMI1_SDA / HDMI1_HPD are intentionally NOT constrained in
# this first version: no EDID read and no hot-plug logic are implemented.
# The external level shifters / pull-ups keep DDC idle high.
