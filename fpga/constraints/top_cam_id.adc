# ============================================================================
# top_cam_id.adc
# 最小上板工程（SCCB 读 Chip ID）的引脚约束
#
# 顶层：top_cam_id
# 器件：PH1P35MDG324（PH1P35_FT V1 / HX1P35B_FT_40P）
# 依据：docs/hardware/wiring.md；P01_FPGA_2；P05_GPIO
#
# 本测试只使用：50MHz、4 个 LED、SCCB、RESET、PWDN。
# PCLK/DVP 数据暂不分配，留到 DVP 采集阶段。
# ============================================================================

# 50MHz 有源晶振（U31 -> FPGA_A_SYSCLK_50MHZ，BANK42）
set_pin_assignment { clk_50m } { LOCATION = D4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# 4 bit LED，高电平点亮（BANK42，1K 限流）
set_pin_assignment { led[0] } { LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[1] } { LOCATION = C6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[2] } { LOCATION = D6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[3] } { LOCATION = A5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# SCCB（BANK22）
# 原厂模组与板卡都未画外部上拉，这里先启用 FPGA 内部上拉做首测；
# 若通信仍失败，再在 SCL/SDA 上补 4.7k 外部上拉。
set_pin_assignment { cam_scl } { LOCATION = R6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { cam_sda } { LOCATION = T5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# 摄像头控制（BANK22）
# RESET 低有效：内部上拉，保证 FPGA 配置前不处于复位。
set_pin_assignment { cam_reset_n } { LOCATION = U7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
# PWDN 高有效：暂用 NONE，配置后由 RTL 拉低。
set_pin_assignment { cam_pwdn } { LOCATION = U6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
