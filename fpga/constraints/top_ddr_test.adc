# ============================================================================
# top_ddr_test.adc
# Pin constraints for the independent DDR bring-up test.
#
# Device: PH1P35MDG324 (PH1P35_FT V1 / HX1P35B_FT_40P)
#
# Only board-level pins are constrained here:
#   - 50 MHz oscillator on C4 (also used as the DDR ref_clk)
#   - LEDs D10/E10/C6/D6 = LED1..LED4
#
# The DDR pins are IN-PACKAGE (SiP). They are NOT board pins and MUST NOT
# be assigned here. The vendor IP ADC (ddr2.adc) assigns the IP pins to the
# internal DDR PHY sites (X0Y...). Do not copy those site assignments into
# this file.
# ============================================================================

set_pin_assignment { clk_50m } { LOCATION = C4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

set_pin_assignment { led[0] } { LOCATION = D10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[1] } { LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[2] } { LOCATION = C6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[3] } { LOCATION = D6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
